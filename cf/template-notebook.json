{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Creates a SageMaker Notebook Instance with an IAM execution role scoped for running the medgemma-deployment notebooks (real-time endpoint and batch transform).",
  "Metadata": {
    "AWS::CloudFormation::Interface": {
      "ParameterGroups": [
        {
          "Label": {
            "default": "Notebook Options"
          },
          "Parameters": [
            "NotebookInstanceName",
            "InstanceType",
            "VolumeSizeGB"
          ]
        },
        {
          "Label": {
            "default": "Advanced Configuration"
          },
          "Parameters": [
            "IAMRole",
            "S3DataBucketName"
          ]
        }
      ],
      "ParameterLabels": {
        "NotebookInstanceName": {
          "default": "Notebook Instance Name"
        },
        "InstanceType": {
          "default": "Instance Type"
        },
        "VolumeSizeGB": {
          "default": "Volume Size (GB)"
        },
        "IAMRole": {
          "default": "SageMaker Execution Role ARN"
        },
        "S3DataBucketName": {
          "default": "S3 Data Bucket Name"
        }
      }
    }
  },
  "Parameters": {
    "NotebookInstanceName": {
      "Type": "String",
      "Default": "medgemma-notebook",
      "Description": "Name for the SageMaker Notebook Instance.",
      "AllowedPattern": "^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$",
      "ConstraintDescription": "Must be 1-63 characters, start/end with a letter or number, and contain only letters, numbers, and hyphens."
    },
    "InstanceType": {
      "Type": "String",
      "Default": "ml.t3.medium",
      "Description": "SageMaker Notebook Instance type. ml.t3.medium is sufficient for running the notebooks; the heavy compute happens inside SageMaker endpoints/batch jobs.",
      "AllowedValues": [
        "ml.t3.medium",
        "ml.t3.large",
        "ml.t3.xlarge",
        "ml.t3.2xlarge",
        "ml.m5.xlarge",
        "ml.m5.2xlarge"
      ]
    },
    "VolumeSizeGB": {
      "Type": "Number",
      "Default": 20,
      "MinValue": 5,
      "MaxValue": 500,
      "Description": "Size in GB of the EBS volume attached to the notebook instance."
    },
    "IAMRole": {
      "Type": "String",
      "Default": "",
      "Description": "Optional SageMaker execution role ARN. Leave blank to let this stack create one.",
      "AllowedPattern": "^$|^arn:aws(-[a-z]+)?:iam::[0-9]{12}:role/.+",
      "ConstraintDescription": "Must be blank or a valid IAM role ARN."
    },
    "S3DataBucketName": {
      "Type": "String",
      "Default": "",
      "Description": "Optional name of the S3 bucket where your data lives. The notebook execution role will be granted read/write access to this bucket. Leave blank to skip. Only applies when this stack creates the IAM role.",
      "AllowedPattern": "^$|^[a-z0-9][a-z0-9\\-\\.]{1,61}[a-z0-9]$",
      "ConstraintDescription": "Must be blank or a valid S3 bucket name (3-63 lowercase characters, numbers, hyphens, or dots)."
    }
  },
  "Conditions": {
    "CreateExecutionRole": {
      "Fn::Equals": [
        {
          "Ref": "IAMRole"
        },
        ""
      ]
    },
    "HasDataBucket": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "S3DataBucketName"
            },
            ""
          ]
        }
      ]
    },
    "CreateBucketPolicy": {
      "Fn::And": [
        {
          "Condition": "CreateExecutionRole"
        },
        {
          "Condition": "HasDataBucket"
        }
      ]
    }
  },
  "Resources": {
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "CreateExecutionRole",
      "Properties": {
        "RoleName": {
          "Fn::Sub": "${AWS::StackName}-notebook-role"
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "sagemaker.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AmazonSageMakerFullAccess"
        ],
        "Policies": [
          {
            "PolicyName": "notebook-s3-and-marketplace",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "S3Access",
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject",
                    "s3:ListBucket",
                    "s3:GetBucketLocation",
                    "s3:CreateBucket"
                  ],
                  "Resource": [
                    "arn:aws:s3:::*sagemaker*",
                    "arn:aws:s3:::*sagemaker*/*"
                  ]
                },
                {
                  "Sid": "MarketplaceModelPackage",
                  "Effect": "Allow",
                  "Action": [
                    "aws-marketplace:ViewSubscriptions",
                    "aws-marketplace:Subscribe",
                    "aws-marketplace:Unsubscribe"
                  ],
                  "Resource": "*"
                },
                {
                  "Sid": "CloudWatchLogs",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogGroup",
                    "logs:CreateLogStream",
                    "logs:DescribeLogStreams",
                    "logs:PutLogEvents",
                    "logs:GetLogEvents"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:aws:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/sagemaker/*"
                    }
                  ]
                },
                {
                  "Sid": "PassRoleToSageMaker",
                  "Effect": "Allow",
                  "Action": "iam:PassRole",
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "iam:PassedToService": "sagemaker.amazonaws.com"
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "DataBucketPolicy": {
      "Type": "AWS::IAM::Policy",
      "Condition": "CreateBucketPolicy",
      "Properties": {
        "PolicyName": "notebook-data-bucket-access",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DataBucketAccess",
              "Effect": "Allow",
              "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject",
                "s3:ListBucket",
                "s3:GetBucketLocation"
              ],
              "Resource": [
                {
                  "Fn::Sub": "arn:aws:s3:::${S3DataBucketName}"
                },
                {
                  "Fn::Sub": "arn:aws:s3:::${S3DataBucketName}/*"
                }
              ]
            }
          ]
        },
        "Roles": [
          {
            "Ref": "ExecutionRole"
          }
        ]
      }
    },
    "NotebookInstance": {
      "Type": "AWS::SageMaker::NotebookInstance",
      "Properties": {
        "NotebookInstanceName": {
          "Ref": "NotebookInstanceName"
        },
        "InstanceType": {
          "Ref": "InstanceType"
        },
        "VolumeSizeInGB": {
          "Ref": "VolumeSizeGB"
        },
        "RoleArn": {
          "Fn::If": [
            "CreateExecutionRole",
            {
              "Fn::GetAtt": [
                "ExecutionRole",
                "Arn"
              ]
            },
            {
              "Ref": "IAMRole"
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "NotebookInstanceName": {
      "Description": "SageMaker Notebook Instance name.",
      "Value": {
        "Ref": "NotebookInstanceName"
      }
    },
    "NotebookURL": {
      "Description": "Direct link to open JupyterLab on the notebook instance.",
      "Value": {
        "Fn::Sub": "https://${AWS::Region}.console.aws.amazon.com/sagemaker/home?region=${AWS::Region}#/notebook-instances/openNotebook/${NotebookInstanceName}?view=lab"
      }
    },
    "ExecutionRoleArn": {
      "Description": "SageMaker execution role ARN used by the notebook instance.",
      "Value": {
        "Fn::If": [
          "CreateExecutionRole",
          {
            "Fn::GetAtt": [
              "ExecutionRole",
              "Arn"
            ]
          },
          {
            "Ref": "IAMRole"
          }
        ]
      }
    }
  }
}
